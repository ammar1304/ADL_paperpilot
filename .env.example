# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_hex(24))"

# ---- Postgres (used by n8n and pp-tools) ----------------------------------
POSTGRES_USER=paperpilot
# Letters and digits only: this value is embedded in a connection URL.
POSTGRES_PASSWORD=change-me-letters-and-digits-only
N8N_DB_NAME=n8n
APP_DB_NAME=paperpilot
# Host port for Postgres. 5433 avoids clashing with a Postgres already on 5432.
POSTGRES_HOST_PORT=5433

# ---- n8n -------------------------------------------------------------------
# Encrypts credentials stored in n8n. Generate once and share it with the team
# privately: losing or changing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
# true: every start replaces the workflows in n8n with n8n/workflows/*.json.
# Export UI edits first with ./scripts/export_workflows.sh.
PP_IMPORT_WORKFLOWS_ON_START=true
# true enables the header-triggered test fault used by scripts/smoke_test.py
# to check the error workflow. Harmless, but set false for the final demo.
PP_ALLOW_TEST_FAULTS=true
TZ=Africa/Tunis

# ---- pp-tools ----------------------------------------------------------------
LOG_LEVEL=INFO
# Linux only: your user and group ids (run `id -u` and `id -g`), so files the
# container writes in corpus/, eval/ and .cache/ belong to you. Docker Desktop
# (Windows, macOS) ignores ownership; leave the defaults.
PP_UID=1000
PP_GID=1000

# ---- corpus and retrieval (milestone 1) ---------------------------------------------
# Put a team email here: it is sent in the User-Agent so arXiv can contact you.
ARXIV_CONTACT_EMAIL=
# Embedding model served by Text Embeddings Inference.
EMBEDDING_MODEL=BAAI/bge-m3
# Apple Silicon: ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9
EMBEDDER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# Chunk size and overlap in approximate tokens (both strategies use the same budget).
CHUNK_TOKENS=512
CHUNK_OVERLAP=64

# Chunking strategy the novelty branch searches: structured or fixed (decide from E1).
NOVELTY_STRATEGY=structured

# ---- LLMs (milestone 2) ----------------------------------------------------------------
# Groq: main provider (gpt-oss-20b, gpt-oss-120b). Free key at https://console.groq.com
GROQ_API_KEY=
# Gemini: fallback when Groq fails or is rate-limited. Free key at https://aistudio.google.com
# The free tier may use requests to improve Google's products: public papers only, never unpublished drafts.
GEMINI_API_KEY=

# ---- Not used yet (later milestones) ------------------------------------------
# Semantic Scholar API key, raises rate limits (milestone 2).
SEMANTIC_SCHOLAR_API_KEY=
# MinerU parsing service URL (milestone 3).
MINERU_URL=
