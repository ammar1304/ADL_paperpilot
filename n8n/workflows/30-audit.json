{
 "id": "pp30Audit0000001",
 "name": "30-audit",
 "active": false,
 "nodes": [
  {
   "id": "c3f2e8f4-0001-4c9a-9c33-000000000001",
   "name": "Called by router",
   "notes": "Receives the run record (run_id, mode, input, ...) from 00-router.",
   "type": "n8n-nodes-base.executeWorkflowTrigger",
   "typeVersion": 1.1,
   "position": [
    0,
    300
   ],
   "parameters": {
    "inputSource": "passthrough"
   }
  },
  {
   "id": "c3f2e8f4-0002-4c9a-9c33-000000000002",
   "name": "Start parse",
   "notes": "pp-tools downloads the PDF and sends it to the parser service (Docling, D31) as a background job; a PDF parsed before comes from the cache (D32).",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    220,
    300
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 3000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/parse?n8n_execution_id={{ $execution.id }}",
    "options": {
     "timeout": 15000
    }
   }
  },
  {
   "id": "c3f2e8f4-0003-4c9a-9c33-000000000003",
   "name": "Wait 10 s",
   "type": "n8n-nodes-base.wait",
   "typeVersion": 1.1,
   "position": [
    440,
    300
   ],
   "webhookId": "03000000-0000-0000-0000-000000000003",
   "parameters": {
    "resume": "timeInterval",
    "amount": 10,
    "unit": "seconds"
   }
  },
  {
   "id": "c3f2e8f4-0004-4c9a-9c33-000000000004",
   "name": "Get parse job",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    300
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 3000,
   "parameters": {
    "method": "GET",
    "url": "={{ $env.PP_TOOLS_URL }}/jobs/{{ $('Start parse').first().json.job_id }}",
    "options": {
     "timeout": 10000
    }
   }
  },
  {
   "id": "c3f2e8f4-0005-4c9a-9c33-000000000005",
   "name": "Parse status",
   "type": "n8n-nodes-base.switch",
   "typeVersion": 3.2,
   "position": [
    880,
    300
   ],
   "parameters": {
    "rules": {
     "values": [
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict",
         "version": 2
        },
        "conditions": [
         {
          "id": "c3000001-0000-4000-8000-000000000001",
          "leftValue": "={{ $json.status }}",
          "rightValue": "done",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "done"
      },
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict",
         "version": 2
        },
        "conditions": [
         {
          "id": "c3000002-0000-4000-8000-000000000002",
          "leftValue": "={{ $json.status }}",
          "rightValue": "failed",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "failed"
      }
     ]
    },
    "options": {
     "fallbackOutput": "extra",
     "renameFallbackOutput": "still running"
    }
   }
  },
  {
   "id": "c3f2e8f4-0006-4c9a-9c33-000000000006",
   "name": "Parse failed",
   "type": "n8n-nodes-base.stopAndError",
   "typeVersion": 1,
   "position": [
    1100,
    320
   ],
   "parameters": {
    "errorMessage": "={{ 'Parsing the PDF failed: ' + ($json.error ? $json.error.message : 'no error message') }}"
   }
  },
  {
   "id": "c3f2e8f4-0007-4c9a-9c33-000000000007",
   "name": "Polled too long?",
   "notes": "180 polls x 10 s = 30 minutes. A paper took 2 to 5 minutes on the team PC's CPU (D31).",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1100,
    480
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "strict",
      "version": 2
     },
     "conditions": [
      {
       "id": "c3000003-0000-4000-8000-000000000003",
       "leftValue": "={{ $runIndex }}",
       "rightValue": 180,
       "operator": {
        "type": "number",
        "operation": "gte"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "c3f2e8f4-0008-4c9a-9c33-000000000008",
   "name": "Parse timed out",
   "type": "n8n-nodes-base.stopAndError",
   "typeVersion": 1,
   "position": [
    1320,
    460
   ],
   "parameters": {
    "errorMessage": "={{ 'The PDF was still being parsed after 30 minutes (job ' + $json.job_id + ').' }}"
   }
  },
  {
   "id": "c3f2e8f4-0009-4c9a-9c33-000000000009",
   "name": "Render claim prompts",
   "notes": "pp-tools selects the sentences that can carry a checkable claim and renders P4-claim-extractor once per batch (about 1,800 tokens of sentences).",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1100,
    100
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/claim-prompts",
    "options": {
     "timeout": 60000
    }
   }
  },
  {
   "id": "c3f2e8f4-0010-4c9a-9c33-000000000010",
   "name": "One item per batch",
   "type": "n8n-nodes-base.splitOut",
   "typeVersion": 1,
   "position": [
    1320,
    100
   ],
   "parameters": {
    "fieldToSplitOut": "batches",
    "options": {}
   }
  },
  {
   "id": "c3f2e8f4-0011-4c9a-9c33-000000000011",
   "name": "Loop over batches",
   "notes": "One batch at a time, with a 40 s pause after each: Groq's free tier allows 8,000 tokens per minute for gpt-oss-20b, counting input plus the output budget (D12, D33).",
   "type": "n8n-nodes-base.splitInBatches",
   "typeVersion": 3,
   "position": [
    1540,
    100
   ],
   "parameters": {
    "batchSize": 1,
    "options": {}
   }
  },
  {
   "id": "c3f2e8f4-0012-4c9a-9c33-000000000012",
   "name": "Extract claims",
   "notes": "LLM call per batch: P4 turns sentences into structured claims. Groq gpt-oss-20b only: a draft is never sent to the Gemini free tier (D12). A rate-limit refusal (429) is retried after 30 s, up to 3 tries.",
   "type": "@n8n/n8n-nodes-langchain.chainLlm",
   "typeVersion": 1.9,
   "position": [
    1760,
    200
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 30000,
   "parameters": {
    "promptType": "define",
    "text": "={{ $json.user }}",
    "hasOutputParser": true,
    "needsFallback": false,
    "messages": {
     "messageValues": [
      {
       "type": "SystemMessagePromptTemplate",
       "message": "={{ $json.system }}"
      }
     ]
    },
    "batching": {}
   }
  },
  {
   "id": "c3f2e8f4-0013-4c9a-9c33-000000000013",
   "name": "Groq gpt-oss-20b (claims)",
   "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
   "typeVersion": 1,
   "position": [
    1700,
    440
   ],
   "parameters": {
    "model": "openai/gpt-oss-20b",
    "options": {
     "temperature": 0,
     "maxTokensToSample": 3000
    }
   },
   "credentials": {
    "groqApi": {
     "id": "ppGroqCredent001",
     "name": "Groq (PaperPilot)"
    }
   }
  },
  {
   "id": "c3f2e8f4-0014-4c9a-9c33-000000000014",
   "name": "Claims schema",
   "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
   "typeVersion": 1.3,
   "position": [
    1900,
    440
   ],
   "parameters": {
    "schemaType": "manual",
    "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"claims\": {\n      \"type\": \"array\",\n      \"maxItems\": 60,\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"sentence_id\": {\n            \"type\": \"string\"\n          },\n          \"type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"result\",\n              \"comparison\",\n              \"figure\",\n              \"citation\",\n              \"other\"\n            ]\n          },\n          \"claim\": {\n            \"type\": \"string\"\n          },\n          \"values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"value\": {\n                  \"type\": \"string\"\n                },\n                \"metric\": {\n                  \"type\": \"string\"\n                },\n                \"dataset\": {\n                  \"type\": \"string\"\n                },\n                \"system\": {\n                  \"type\": \"string\"\n                },\n                \"setting\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"value\",\n                \"metric\",\n                \"dataset\",\n                \"system\",\n                \"setting\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"comparison\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"system\": {\n                \"type\": \"string\"\n              },\n              \"baseline\": {\n                \"type\": \"string\"\n              },\n              \"difference\": {\n                \"type\": \"string\"\n              },\n              \"kind\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"absolute\",\n                  \"relative\",\n                  \"unspecified\"\n                ]\n              },\n              \"direction\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"better\",\n                  \"worse\",\n                  \"equal\"\n                ]\n              }\n            },\n            \"required\": [\n              \"system\",\n              \"baseline\",\n              \"difference\",\n              \"kind\",\n              \"direction\"\n            ],\n            \"additionalProperties\": false\n          },\n          \"refers_to\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"cites\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"sentence_id\",\n          \"type\",\n          \"claim\",\n          \"values\",\n          \"refers_to\",\n          \"cites\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"claims\"\n  ],\n  \"additionalProperties\": false\n}",
    "autoFix": false
   }
  },
  {
   "id": "c3f2e8f4-0015-4c9a-9c33-000000000015",
   "name": "Save claims",
   "notes": "pp-tools validates the batch again and drops any claim whose numbers are not in its sentence.",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1980,
    200
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/claims",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ batch: $('Loop over batches').item.json.batch, output: $json.output }) }}",
    "options": {
     "timeout": 60000
    }
   }
  },
  {
   "id": "c3f2e8f4-0016-4c9a-9c33-000000000016",
   "name": "Pause 40 s",
   "type": "n8n-nodes-base.wait",
   "typeVersion": 1.1,
   "position": [
    2200,
    200
   ],
   "webhookId": "03000000-0000-0000-0000-000000000016",
   "parameters": {
    "resume": "timeInterval",
    "amount": 40,
    "unit": "seconds"
   },
   "notes": "Groq's free tier: 8,000 tokens per minute for gpt-oss-20b, and one call uses about 6,500 (input plus output budget). 40 s lets the window drain."
  },
  {
   "id": "c3f2e8f4-0017-4c9a-9c33-000000000017",
   "name": "Assemble result",
   "notes": "The audit result so far: parsed paper and claims. Steps 4 to 6 add the checks. Runs once: the loop's done output carries one item per batch.",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1760,
    0
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/result",
    "options": {
     "timeout": 60000
    }
   },
   "executeOnce": true
  }
 ],
