{
 "id": "pp30Audit0000001",
 "name": "30-audit",
 "active": false,
 "nodes": [
  {
   "id": "c3f2e8f4-0001-4c9a-9c33-000000000001",
   "name": "Called by router",
   "notes": "Receives the run record (run_id, mode, input, ...) from 00-router.",
   "type": "n8n-nodes-base.executeWorkflowTrigger",
   "typeVersion": 1.1,
   "position": [
    0,
    300
   ],
   "parameters": {
    "inputSource": "passthrough"
   }
  },
  {
   "id": "c3f2e8f4-0002-4c9a-9c33-000000000002",
   "name": "Start parse",
   "notes": "pp-tools downloads the PDF and sends it to the parser service (Docling, D31) as a background job; a PDF parsed before comes from the cache (D32).",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    220,
    300
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 3000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/parse?n8n_execution_id={{ $execution.id }}",
    "options": {
     "timeout": 15000
    }
   }
  },
  {
   "id": "c3f2e8f4-0003-4c9a-9c33-000000000003",
   "name": "Wait 10 s",
   "type": "n8n-nodes-base.wait",
   "typeVersion": 1.1,
   "position": [
    440,
    300
   ],
   "webhookId": "03000000-0000-0000-0000-000000000003",
   "parameters": {
    "resume": "timeInterval",
    "amount": 10,
    "unit": "seconds"
   }
  },
  {
   "id": "c3f2e8f4-0004-4c9a-9c33-000000000004",
   "name": "Get parse job",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    300
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 3000,
   "parameters": {
    "method": "GET",
    "url": "={{ $env.PP_TOOLS_URL }}/jobs/{{ $('Start parse').first().json.job_id }}",
    "options": {
     "timeout": 10000
    }
   }
  },
  {
   "id": "c3f2e8f4-0005-4c9a-9c33-000000000005",
   "name": "Parse status",
   "type": "n8n-nodes-base.switch",
   "typeVersion": 3.2,
   "position": [
    880,
    300
   ],
   "parameters": {
    "rules": {
     "values": [
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict",
         "version": 2
        },
        "conditions": [
         {
          "id": "c3000001-0000-4000-8000-000000000001",
          "leftValue": "={{ $json.status }}",
          "rightValue": "done",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "done"
      },
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict",
         "version": 2
        },
        "conditions": [
         {
          "id": "c3000002-0000-4000-8000-000000000002",
          "leftValue": "={{ $json.status }}",
          "rightValue": "failed",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "failed"
      }
     ]
    },
    "options": {
     "fallbackOutput": "extra",
     "renameFallbackOutput": "still running"
    }
   }
  },
  {
   "id": "c3f2e8f4-0006-4c9a-9c33-000000000006",
   "name": "Parse failed",
   "type": "n8n-nodes-base.stopAndError",
   "typeVersion": 1,
   "position": [
    1100,
    320
   ],
   "parameters": {
    "errorMessage": "={{ 'Parsing the PDF failed: ' + ($json.error ? $json.error.message : 'no error message') }}"
   }
  },
  {
   "id": "c3f2e8f4-0007-4c9a-9c33-000000000007",
   "name": "Polled too long?",
   "notes": "180 polls x 10 s = 30 minutes. A paper took 2 to 5 minutes on the team PC's CPU (D31).",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1100,
    480
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "strict",
      "version": 2
     },
     "conditions": [
      {
       "id": "c3000003-0000-4000-8000-000000000003",
       "leftValue": "={{ $runIndex }}",
       "rightValue": 180,
       "operator": {
        "type": "number",
        "operation": "gte"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "c3f2e8f4-0008-4c9a-9c33-000000000008",
   "name": "Parse timed out",
   "type": "n8n-nodes-base.stopAndError",
   "typeVersion": 1,
   "position": [
    1320,
    460
   ],
   "parameters": {
    "errorMessage": "={{ 'The PDF was still being parsed after 30 minutes (job ' + $json.job_id + ').' }}"
   }
  },
  {
   "id": "c3f2e8f4-0015-4c9a-9c33-000000000015",
   "name": "Save claims",
   "notes": "pp-tools validates the batch again and drops any claim whose numbers are not in its sentence. An invalid output (HTTP 409) does not stop the run: the batch is served again, up to 3 attempts.",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1980,
    200
   ],
   "maxTries": 3,
   "waitBetweenTries": 2000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/claims",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ batch: $('Next claim batch').last().json.batch, output_text: $json.choices[0].message.content, usage: $json.usage }) }}",
    "options": {
     "timeout": 60000,
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     }
    }
   }
  },
  {
   "id": "c3f2e8f4-0017-4c9a-9c33-000000000017",
   "name": "Assemble result",
   "notes": "The audit result so far: parsed paper and claims. Steps 4 to 6 add the checks.",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1540,
    0
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/result",
    "options": {
     "timeout": 60000
    }
   }
  },
  {
   "id": "c3f2e8f4-0009-4c9a-9c33-000000000009",
   "name": "Next claim batch",
   "notes": "pp-tools serves the next batch of candidate sentences with P4 rendered, or {done: true}. It keeps the loop's state: a batch is finished once a valid output is saved or after 3 attempts (F-012), so a rate-limited call is simply served again.",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1100,
    100
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 2000,
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/claims/next",
    "options": {
     "timeout": 60000
    }
   }
  },
  {
   "id": "c3f2e8f4-0010-4c9a-9c33-000000000010",
   "name": "More batches?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1320,
    100
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "c3000010-0000-4000-8000-000000000010",
       "leftValue": "={{ $json.done }}",
       "rightValue": false,
       "operator": {
        "type": "boolean",
        "operation": "false",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "c3f2e8f4-0016-4c9a-9c33-000000000016",
   "name": "Pause 65 s",
   "notes": "Before every LLM call. gpt-oss-20b's hidden reasoning makes one call use 6,000 to 7,000 of the 8,000 tokens Groq's free tier allows per minute (F-012), so calls are a minute apart.",
   "type": "n8n-nodes-base.wait",
   "typeVersion": 1.1,
   "position": [
    1540,
    200
   ],
   "webhookId": "03000000-0000-0000-0000-000000000016",
   "parameters": {
    "resume": "timeInterval",
    "amount": 65,
    "unit": "seconds"
   }
  },
  {
   "id": "c3f2e8f4-0012-4c9a-9c33-000000000012",
   "name": "Extract claims",
   "notes": "LLM call per batch, straight to Groq's API: P4 turns sentences into structured claims. Not the n8n LLM-chain node, because it cannot set reasoning_effort or Groq's strict JSON schema: with default reasoning, gpt-oss used its whole output budget thinking and returned nothing (F-013). Groq only: a draft is never sent to the Gemini free tier (D12). Errors (rate limit, empty output) go to 'Record LLM error', then the batch is served again.",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1760,
    200
   ],
   "onError": "continueErrorOutput",
   "parameters": {
    "method": "POST",
    "url": "https://api.groq.com/openai/v1/chat/completions",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "groqApi",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ model: 'openai/gpt-oss-20b', temperature: 0, reasoning_effort: 'low', include_reasoning: false, max_completion_tokens: 3500, messages: [{ role: 'system', content: $json.system }, { role: 'user', content: $json.user }], response_format: { type: 'json_schema', json_schema: { name: 'claims', strict: true, schema: {\"type\": \"object\", \"properties\": {\"claims\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"sentence_id\": {\"type\": \"string\"}, \"type\": {\"type\": \"string\", \"enum\": [\"result\", \"comparison\", \"figure\", \"citation\", \"other\"]}, \"claim\": {\"type\": \"string\"}, \"values\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"value\": {\"type\": \"string\"}, \"metric\": {\"type\": \"string\"}, \"dataset\": {\"type\": \"string\"}, \"system\": {\"type\": \"string\"}, \"setting\": {\"type\": \"string\"}}, \"required\": [\"value\", \"metric\", \"dataset\", \"system\", \"setting\"], \"additionalProperties\": false}}, \"comparison\": {\"type\": [\"object\", \"null\"], \"properties\": {\"system\": {\"type\": \"string\"}, \"baseline\": {\"type\": \"string\"}, \"difference\": {\"type\": \"string\"}, \"kind\": {\"type\": \"string\", \"enum\": [\"absolute\", \"relative\", \"unspecified\"]}, \"direction\": {\"type\": \"string\", \"enum\": [\"better\", \"worse\", \"equal\"]}}, \"required\": [\"system\", \"baseline\", \"difference\", \"kind\", \"direction\"], \"additionalProperties\": false}, \"refers_to\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"cites\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"sentence_id\", \"type\", \"claim\", \"values\", \"comparison\", \"refers_to\", \"cites\"], \"additionalProperties\": false}}}, \"required\": [\"claims\"], \"additionalProperties\": false} } } }) }}",
    "options": {
     "timeout": 120000
    }
   },
   "credentials": {
    "groqApi": {
     "id": "ppGroqCredent001",
     "name": "Groq (PaperPilot)"
    }
   }
  },
  {
   "id": "c3f2e8f4-0018-4c9a-9c33-000000000018",
   "name": "Record LLM error",
   "notes": "Stores why an LLM call failed (rate limit, empty output, HTTP error) as a run step, so a failed batch is never silent.",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1980,
    400
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $env.PP_TOOLS_URL }}/audit/{{ $('Called by router').first().json.run_id }}/claims/error",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ batch: $('Next claim batch').last().json.batch, error: JSON.stringify($json).slice(0, 2000) }) }}",
    "options": {
     "timeout": 30000,
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     }
    }
   }
  }
 ],
