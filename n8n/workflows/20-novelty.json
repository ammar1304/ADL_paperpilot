    {
      "id": "e6c5b1c7-0013-4f2d-9f66-000000000013",
      "name": "Judgement schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1880,
        560
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"maxItems\": 12,\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"paper_id\": {\n            \"type\": \"string\"\n          },\n          \"overlap\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"task\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"same\",\n                  \"partial\",\n                  \"different\",\n                  \"unknown\"\n                ]\n              },\n              \"method\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"same\",\n                  \"partial\",\n                  \"different\",\n                  \"unknown\"\n                ]\n              },\n              \"data\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"same\",\n                  \"partial\",\n                  \"different\",\n                  \"unknown\"\n                ]\n              },\n              \"result\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"same\",\n                  \"partial\",\n                  \"different\",\n                  \"unknown\"\n                ]\n              }\n            },\n            \"required\": [\n              \"task\",\n              \"method\",\n              \"data\",\n              \"result\"\n            ],\n            \"additionalProperties\": false\n          },\n          \"evidence\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"rationale\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"paper_id\",\n          \"overlap\",\n          \"evidence\",\n          \"rationale\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"matches\",\n    \"summary\"\n  ],\n  \"additionalProperties\": false\n}",
        "autoFix": false
      }
    },
    {
      "id": "e6c5b1c7-0014-4f2d-9f66-000000000014",
      "name": "Verify",
      "notes": "The verifier: plain code, no LLM. Rejects papers and chunk ids that retrieval did not return. Answers pass, retry (once) or final.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_TOOLS_URL }}/novelty/{{ $('Called by router').first().json.run_id }}/verify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ output: $json.output, prompt_version: $('Render judge prompt').last().json.version }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "e6c5b1c7-0015-4f2d-9f66-000000000015",
      "name": "Verifier verdict",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        2220,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c2000001-0000-4000-8000-000000000001",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "retry",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "retry with feedback"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "accepted"
        }
      }
    },
    {
      "id": "e6c5b1c7-0016-4f2d-9f66-000000000016",
      "name": "Assemble result",
      "notes": "Builds the branch result only from stored, verified steps; returned to 00-router.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2460,
        380
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_TOOLS_URL }}/novelty/{{ $('Called by router').first().json.run_id }}/result",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 60000
        }
      }
    }
