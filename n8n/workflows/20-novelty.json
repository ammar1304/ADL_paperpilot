    {
      "id": "e6c5b1c7-0006-4f2d-9f66-000000000006",
      "name": "Facets schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        780,
        560
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"facets\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"task\": {\n          \"type\": \"string\",\n          \"description\": \"the problem or task addressed\"\n        },\n        \"method\": {\n          \"type\": \"string\",\n          \"description\": \"the core technique proposed\"\n        },\n        \"data\": {\n          \"type\": \"string\",\n          \"description\": \"datasets or benchmarks, or 'not specified'\"\n        },\n        \"result\": {\n          \"type\": \"string\",\n          \"description\": \"claimed or expected outcome, or 'not specified'\"\n        }\n      },\n      \"required\": [\n        \"task\",\n        \"method\",\n        \"data\",\n        \"result\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"queries\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"maxItems\": 8,\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"facets\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"task\",\n                \"method\",\n                \"data\",\n                \"result\"\n              ]\n            }\n          }\n        },\n        \"required\": [\n          \"text\",\n          \"facets\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"facets\",\n    \"queries\"\n  ],\n  \"additionalProperties\": false\n}",
        "autoFix": false
      }
    },
    {
      "id": "e6c5b1c7-0007-4f2d-9f66-000000000007",
      "name": "Save facets",
      "notes": "pp-tools validates the LLM output again (strict) and stores it as a run step.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_TOOLS_URL }}/novelty/{{ $('Called by router').first().json.run_id }}/facets",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ output: $json.output, prompt_version: $('Render decomposer prompt').first().json.version }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "e6c5b1c7-0008-4f2d-9f66-000000000008",
      "name": "Retrieve candidates",
      "notes": "RAG retrieval: every query searches the knowledge base; rankings are fused (reciprocal rank fusion); top papers with their best evidence chunks.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_TOOLS_URL }}/novelty/{{ $('Called by router').first().json.run_id }}/retrieve",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "e6c5b1c7-0009-4f2d-9f66-000000000009",
      "name": "Render judge prompt",
      "notes": "Fills P3-novelty-judge with the facets and candidates. On a retry it adds the verifier's rejection reasons as feedback.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_TOOLS_URL }}/novelty/{{ $('Called by router').first().json.run_id }}/judge-prompt",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "e6c5b1c7-0010-4f2d-9f66-000000000010",
      "name": "Judge novelty",
