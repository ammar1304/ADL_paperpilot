    },
    {
      "id": "e6c5b1c7-0002-4f2d-9f66-000000000002",
      "name": "Render decomposer prompt",
      "notes": "Loads the active version of P1-decomposer from the prompt library (prompts/) and fills in the idea.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_TOOLS_URL }}/prompts/P1-decomposer/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ variables: { idea_text: $json.input.idea_text } }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "e6c5b1c7-0003-4f2d-9f66-000000000003",
      "name": "Decompose idea",
      "notes": "LLM call 1. Splits the idea into task, method, data and result, and writes search queries. Groq gpt-oss-20b, Gemini as fallback, JSON enforced by the parser.",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        560,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "promptType": "define",
