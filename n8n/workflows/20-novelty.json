        "hasOutputParser": true,
        "needsFallback": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "={{ $json.system }}"
            }
          ]
        },
        "batching": {}
      }
    },
    {
