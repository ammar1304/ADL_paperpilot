  "nodes": [
    {
      "id": "e6c5b1c7-0001-4f2d-9f66-000000000001",
      "name": "Called by router",
      "notes": "Receives the run record from 00-router: run_id, input.idea_text, ...",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "inputSource": "passthrough"
